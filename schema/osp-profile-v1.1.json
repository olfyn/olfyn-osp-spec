{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/olfyn/olfyn-osp-spec/main/schema/osp-profile-v1.1.json",
  "title": "OSP Profile v1.1",
  "description": "Open Scent Protocol v1.1 — includes hybrid capture field",
  "type": "object",
  "required": ["osp_version", "scent_id", "name", "profile", "intensity", "duration_ms", "created_at"],
  "properties": {
    "osp_version":  { "type": "string", "enum": ["1.0", "1.1"] },
    "scent_id":     { "type": "string", "minLength": 3, "maxLength": 128 },
    "name":         { "type": "string", "minLength": 1, "maxLength": 256 },
    "description":  { "type": "string" },
    "author":       { "type": "string" },
    "created_at":   { "type": "string", "format": "date-time" },
    "updated_at":   { "type": "string", "format": "date-time" },
    "profile": {
      "type": "object",
      "required": ["floral","frutal","herbal","leñoso","ahumado","especiado","animal","químico","marino","dulce"],
      "properties": {
        "floral":    { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "frutal":    { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "herbal":    { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "leñoso":    { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "ahumado":   { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "especiado": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "animal":    { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "químico":   { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "marino":    { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "dulce":     { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      },
      "additionalProperties": false
    },
    "intensity":    { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "duration_ms":  { "type": "integer", "minimum": 100 },
    "fade_in_ms":   { "type": "integer", "minimum": 0, "default": 0 },
    "fade_out_ms":  { "type": "integer", "minimum": 0, "default": 0 },
    "repeat":       { "type": "integer", "minimum": 0, "default": 1 },
    "interval_ms":  { "type": "integer", "minimum": 0, "default": 0 },
    "capture": {
      "type": "object",
      "properties": {
        "method": { "type": "string", "enum": ["hybrid", "manual", "predefined"] },
        "sensor_data": {
          "type": "object",
          "properties": {
            "voc_index":     { "type": "number", "minimum": 0, "maximum": 500 },
            "voc_raw":       { "type": "number" },
            "temperature":   { "type": "number" },
            "humidity":      { "type": "number", "minimum": 0, "maximum": 100 },
            "dominant_note": { "type": "string" },
            "volatility":    { "type": "string", "enum": ["high", "medium", "low"] },
            "readings":      { "type": "array", "items": { "type": "number" } }
          }
        },
        "verbal_description": { "type": "string" },
        "ai_model":           { "type": "string" },
        "confidence":         { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "category": { "type": "string" },
        "person":   { "type": "string" },
        "tags":     { "type": "array", "items": { "type": "string" } },
        "notes":    { "type": "string" },
        "language": { "type": "string" }
      }
    },
    "extensions": { "type": "object" }
  }
}
